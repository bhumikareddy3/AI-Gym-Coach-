# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
venv/
env/
ENV/
.venv/
.conda/

# ---- Project data (local, user-specific, regenerated at runtime) ----
data/*.db
data/*.sqlite
data/*.sqlite3
data/real/
!data/.gitkeep

# Trained model artifacts are regenerated by `python train_classifier.py`.
# Keep the folder in git, ignore the (potentially large) binary itself.
models/*.joblib
models/*.pkl
!models/.gitkeep

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ---- Logs ----
*.log
uvicorn.log

# ---- Env / secrets ----
.env
.env.local
*.pem
*.key

# ---- Jupyter ----
.ipynb_checkpoints/